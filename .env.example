# PostgreSQL connection for the BQ service
DATABASE_URL=postgres://kadiria:change-me@127.0.0.1:5432/kadiria

# 32+ random characters, used to seal session cookies (nuxt-auth-utils)
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters

# First administrator account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now

# Comma-separated origins allowed to embed calculators / call the public API
# (e.g. a company website). Can also be managed in Admin → Integration.
NUXT_PUBLIC_SITE_NAME=Kadiria
